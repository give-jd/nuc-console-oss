# Windows batch files need CRLF line endings; the shell scripts must keep LF even in a Windows checkout or ZIP
*.cmd text eol=crlf
*.sh text eol=lf
bin/nuc-console-accept text eol=lf
bin/nuc-console-problems text eol=lf
bin/nuc-console-telegram text eol=lf
bin/nuc-console-update text eol=lf
bin/nuc-console-ai text eol=lf
bin/nuc-console-ask text eol=lf
# the golden outputs (tests/golden) are compared byte for byte: a frame ends its lines with CR LF on purpose, so no checkout may convert line ends in them
tests/golden/** -text
