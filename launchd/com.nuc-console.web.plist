<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- nuc-console web view (read-only; only the AI page has buttons), as the unprivileged user _nuc-console. Loaded by install-macos.sh when [web] enabled = yes
     (then as configured there) or [display] mode is browser/fullscreen (then, with web disabled, on 127.0.0.1 only: the "local" option). -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.nuc-console.web</string>
    <key>ProgramArguments</key>
    <array><string>@PYTHON@</string><string>-B</string><string>@DEST@/web.py</string><string>--local</string></array>
    <key>UserName</key><string>_nuc-console</string>
    <key>GroupName</key><string>_nuc-console</string>
    <key>RunAtLoad</key><true/>
    <!-- exit 0 = disabled in config.ini: no restart loop -->
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ThrottleInterval</key><integer>5</integer>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>/var/log/nuc-console/web.log</string>
    <key>StandardErrorPath</key><string>/var/log/nuc-console/web.log</string>
</dict>
</plist>
