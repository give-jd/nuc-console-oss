#!/bin/sh
# Lists every current anomaly of the dashboard (ATTENTION) with why it matters and how to fix it. Read-only, no root needed.
#   nuc-console-problems            human-readable
#   nuc-console-problems --json     machine-readable
# Accept a known one (root):  sudo nuc-console-accept --problem <id> --reason "why it is fine"   (forget: --forget <id>)
exec /usr/bin/python3 /opt/nuc-console/render.py --problems "$@"
