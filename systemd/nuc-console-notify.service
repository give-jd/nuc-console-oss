[Unit]
Description=nuc-console Telegram notifier (sends nothing unless it is on and paired; with the web view on it waits for its Telegram page)
After=network-online.target nuc-console-collector.service
Wants=network-online.target

[Service]
# Outbound HTTPS to api.telegram.org only: no listener, no socket activation; it never reads incoming messages.
Type=simple
# its own user: the web view (nuc-console) cannot read the token
User=nuc-console-notify
Group=nuc-console-notify
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/nuc-console/notify.py
# exit 0 when it has nothing to do (off or not paired, and no web view whose Telegram page may set it up): no restart loop
# (sudo nuc-console-telegram --setup / --on starts it, and so does the web view: Wants= in nuc-console-web.service)
Restart=on-failure
RestartSec=30
# /var/lib/nuc-console-notify: the bot token and the paired chat (0600), status.json and web.json (0644); nobody else can list it.
# Its inbox/ (2730, made by install.sh) holds the web view's requests: only this service lists and reads them
StateDirectory=nuc-console-notify
StateDirectoryMode=0711
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
TasksMax=32
MemoryMax=128M

[Install]
WantedBy=multi-user.target
