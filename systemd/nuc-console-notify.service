[Unit]
Description=nuc-console Telegram notifier (does nothing unless [telegram] enabled = yes in config.ini and paired)
After=network-online.target nuc-console-collector.service
Wants=network-online.target

[Service]
# Outbound HTTPS to api.telegram.org only: no listener, no socket activation; it never reads incoming messages.
Type=simple
User=nuc-console
Group=nuc-console
ExecStart=/usr/bin/python3 -B /opt/nuc-console/notify.py
# exit 0 when disabled or not paired: no restart loop (sudo nuc-console-telegram --setup / --on starts it)
Restart=on-failure
RestartSec=30
# /var/lib/nuc-console-notify: the bot token and the paired chat (0600), status.json (0644); nobody else can list it
StateDirectory=nuc-console-notify
StateDirectoryMode=0711
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
TasksMax=32
MemoryMax=128M

[Install]
WantedBy=multi-user.target
