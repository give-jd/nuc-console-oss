// nuc-console: the web account may run the fixes of the Execute button, and nothing else (docs/INSTALL.md, SECURITY.md).
// Installed by install.sh only while [web] fix_actions = yes. Generated from src/fixactions.py TABLE: do not edit.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "nuc-console" &&
        (
         (action.lookup("unit") == "nuc-console-collector.service" && action.lookup("verb") == "restart") ||
         (action.lookup("unit") == "nuc-console-peers.service" && action.lookup("verb") == "start"))) {
        return polkit.Result.YES;
    }
});
