[Unit]
Description=nuc-console read-only web view (does nothing unless [web] enabled = yes in config.ini)
After=nuc-console-collector.service

[Service]
Type=simple
User=nuc-console
ExecStart=/usr/bin/python3 /opt/nuc-console/web.py
# exit 0 when disabled: no restart loop
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=multi-user.target
