[Unit]
Description=nuc-console web view: a read-only dashboard, and the buttons of the AI and Telegram pages (does nothing unless [web] enabled = yes in config.ini)
After=nuc-console-collector.service
# the Telegram page hands its requests to the notifier: it runs with the web view (and exits 0 when [telegram] web_actions = no and it is off)
Wants=nuc-console-notify.service

[Service]
Type=simple
User=nuc-console
ExecStart=/usr/bin/python3 /opt/nuc-console/web.py
# exit 0 when disabled: no restart loop
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
# where it may write: the AI folder (docs/AI.md), where the AI page downloads the local model and keeps web.json. - : not an error while it is not there
ReadWritePaths=-/var/lib/nuc-console/ai
# the Telegram page's requests to the notifier (docs/TELEGRAM.md): the inbox is 2730 nuc-console-notify:nuc-console-notify, so this group
# lets the web view create files there and nothing else (it cannot list or read them, nor anything of the notifier's: the token is 0600)
ReadWritePaths=-/var/lib/nuc-console-notify/inbox
SupplementaryGroups=nuc-console-notify
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
# The model server the AI page starts is a child of this service and lives in its cgroup: room for its threads, and for the model, which the page
# refuses to start when it would take more than 85 % of the RAM (the cap is the same share of the machine, not a fixed size).
TasksMax=512
MemoryMax=85%

[Install]
WantedBy=multi-user.target
